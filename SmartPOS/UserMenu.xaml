<Window x:Class="Kasa_otomasyonu.UserMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="User Menu"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="7*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2"
                Background="AliceBlue">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            
                <TextBlock x:Name="CompanyName" Grid.Column="0"
           Text="Company Name"
           FontSize="28"
           VerticalAlignment="Center"
           HorizontalAlignment="Center"
           />
                
           

         
                <Button x:Name="Logout"  Grid.Column="1"
                        Margin="5"
        Content="Log Out"
        Background="White"
        BorderBrush="LightGray"
        FontSize="20"
        HorizontalAlignment="Center" 
        VerticalAlignment="Center" Width="106" Click="LogOut"/>

          

           
                <CheckBox x:Name="CustomerMenuToggle" Grid.Column="2"
          Content="Customer Menu Available"
          FontSize="20"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
          Margin="5"
          IsChecked="False"
          Checked="CustomerMenuAvailable_Checked"
          Unchecked="CustomerMenuAvailable_Unchecked"/>
            
            

        </Grid>
        

        <Border Grid.Row="1" Grid.Column="0"
                BorderBrush="LightGray"
                BorderThickness="1"
                Margin="5">
            <ScrollViewer Background="AliceBlue">
                <StackPanel x:Name="CategoryPanel" Margin="10" Background="AliceBlue"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Grid.Column="1"
                    Background="AliceBlue"
                BorderBrush="LightGray"
                BorderThickness="1"
                Margin="5">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <TextBlock Text="Cart" 
                           Grid.Row="0"
                           FontSize="20"
                           Margin="10"
                           HorizontalAlignment="Center"/>
            
                <ListBox x:Name="CartList"
                         Grid.Row="1"
                         BorderBrush="LightGray"
                         Margin="10"/>
                
                <TextBlock x:Name="TotalPriceText"
                           Grid.Row="2"
                           FontSize="20"
                           Margin="10"
                           HorizontalAlignment="Center"
                           Text="Total: ₺0.00"/>

                <Button x:Name="EmptyTheCart" Content="Empty The Cart"
                        Background="White"
                        Grid.Row="3"
                        Width="150"
                        Height="45"
                        Margin="5"
                        HorizontalAlignment="Stretch" Click="EmptyCart"/>
                <Button x:Name="ApplyTheCart" Content="Appy The Cart"
                        Background="White"
                  Grid.Row="4"
                  Height="45"
                  Margin="5"
                  HorizontalAlignment="Stretch" Click="ApplyCart"/>


            </Grid>

        </Border>

    </Grid>
</Window>


