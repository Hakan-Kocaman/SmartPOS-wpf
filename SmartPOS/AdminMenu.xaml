<Window x:Class="Kasa_otomasyonu.AdminMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kasa_otomasyonu"
        mc:Ignorable="d"
        Title="AdminMenu" Height="600" Width="1000" 
        WindowStartupLocation="CenterScreen">


    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="7*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>




        <Grid  Grid.ColumnSpan="2"> 
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border
                BorderBrush="LightGray"
            Background="AliceBlue"
            BorderThickness="1"  
            Margin="10" Grid.Column="0">
                <TextBlock x:Name="CompanyName" 
                 Text="Company Name"
                 FontSize="30"
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Center"
                  Margin="5"/>
            </Border>

            <Border Grid.Column="1" Margin="10" Background="AliceBlue"
                    BorderBrush="LightGray" BorderThickness="1">
                <Button x:Name="Logout" 
                        Margin="5"
        Content="Log Out"
        Background="White"
        BorderBrush="LightGray"
        FontSize="20"
        HorizontalAlignment="Center" 
        VerticalAlignment="Center" Width="106" Click="LogOut"/>
                
            </Border>
            
    </Grid>
   
        
        
        
        
        
        <Border Grid.Row="1" Grid.Column="0"
            BorderBrush="LightGray"
            Background="AliceBlue"    
            BorderThickness="1"  
            Margin="10">
            <TextBlock  Text="User List"
                        FontSize="30"
                        Margin="5"
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center"/>
        </Border>
        
        
        <Border Grid.Row="1" Grid.Column="1"
            BorderBrush="LightGray"
                Background="AliceBlue"
            BorderThickness="1"  
            Margin="10,10,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Order List"
                 FontSize="30"
                  Margin="5"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Center"/>
                <Button x:Name="RollBackYesterday" Grid.Column="1" Content="Previous" Margin="10"
                        Background="White" Click="RollBackToYesterday">

                </Button>
                <Button x:Name="Today" Grid.Column="2" Content="Today" Margin="10"
                        Background="White" Click="BackToToday">

                </Button>
                <Button x:Name="RollForwardTomorrow" Grid.Column="3" Content="Next" Margin="10"
                        Background="White" Click="RollForwardToTomorrow" IsEnabled="False" 
                        Visibility="Visible">
                    
                </Button>
                <TextBlock Grid.Column="4" x:Name="selectedDatetime" Text="Date"
                 FontSize="20"
                  Margin="5"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
                <Button x:Name="Refresh" Grid.Column="5" Content="Refresh" Margin="10"
              Background="White" Click="RefreshGUI">

                </Button>
            </Grid>
           
        </Border>
        <Border Grid.Row="2" Grid.Column="1"
            BorderBrush="LightGray"
            Background="AliceBlue"
            BorderThickness="1"  
            Margin="10">
            <ScrollViewer>
                <StackPanel x:Name="OrderList"/>
            </ScrollViewer>
            

        </Border>

        <Border Grid.Row="2" Grid.Column="0"
                BorderBrush="LightGray"
                BorderThickness="1"  
                Background="AliceBlue"
                Margin="10">
            <DataGrid x:Name="UserList" Background="AliceBlue" RowBackground="White"
                     FontSize="20"
                     HorizontalContentAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Margin="10"
                     AutoGenerateColumns="True"
                      CanUserAddRows="False"
                     ColumnWidth="Auto"
                    CanUserDeleteRows="False"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"         
                      HeadersVisibility="Column"
                        GridLinesVisibility="None"
                        RowHeaderWidth="0"
                       SelectionMode="Single"
                       SelectionUnit="FullRow"
                      />

        </Border>





    </Grid>
</Window>
