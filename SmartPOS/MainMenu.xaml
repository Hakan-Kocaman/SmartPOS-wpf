<Window x:Name="myapp" x:Class="Kasa_otomasyonu.MainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kasa_otomasyonu"
        mc:Ignorable="d"
        Title="mpapp" Height="350" Width="400" WindowStartupLocation="CenterScreen">
    <Grid x:Name="my_app" Cursor="AppStarting">
        <Border 
                BorderBrush="LightGray"
                BorderThickness="1"
                Background="AliceBlue"
               
                Margin="5"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBox x:Name="UserNameEnterance" Width="150" Height="20"   />

            <Button x:Name="UserLoginButton" Content="User Login"
            Background="White"
            Width="100"
            Height="40"
            Margin="0,20,0,0" Click="User_Login_Button"/>
            <Button x:Name="AdminLoginButton" Content="Admin Login"
                    Background="White"
                Width="100"
                Height="40"
                Margin="0,20,0,0" Click="Admin_Login_Button" />
        </StackPanel>
        <TextBlock x:Name="CompanyName" 
               Text="Company_name"
               HorizontalAlignment="Center"
               TextAlignment="Center"
               Margin="0,30,0,0" 
               VerticalAlignment="Top" 
               Width="350" 
               FontSize="30"/>
    </Grid>


</Window>
